PORT=3005
CORS_ORIGIN="*"

DATABASE_URL="postgresql://lemon:lemon_secret@localhost:5440/lemon_media_db?schema=public"

# Single Admin credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="lemon_admin_change_me"
# Optional scrypt hash instead of plaintext ADMIN_PASSWORD: scrypt:<salt>:<hex>
ADMIN_PASSWORD_HASH=""
JWT_SECRET="lemon_media_jwt_secret_change_me"
MEDIA_SIGNING_SECRET="lemon_media_signing_secret_change_me"
ADMIN_TOKEN_TTL_SECONDS=604800

# Local storage & processing (no S3)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES=524288000
FFMPEG_PATH=""
FFPROBE_PATH=""
NGINX_ACCEL_PREFIX=""

# Optional bridge to lemon-ai-service for Admin Studio
LEMON_AI_SERVICE_URL="http://localhost:3006"
LEMON_AI_SERVICE_API_KEY="lai_dev_media_hub_key"
